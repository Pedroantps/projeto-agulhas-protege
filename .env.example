# ============================================================
# AGULHAS PROTEGE — Variáveis de Ambiente
# Copie para backend/.env e substitua os valores de exemplo.
# NUNCA commite arquivos .env.
# ============================================================

# Database
DATABASE_URL=postgresql+psycopg://agulhas:dev_password@db:5432/agulhas_protege
POSTGRES_DB=agulhas_protege
POSTGRES_USER=agulhas
POSTGRES_PASSWORD=dev_password

# JWT — gere com: openssl rand -hex 32
JWT_SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — lista JSON
CORS_ORIGINS=["http://localhost:5173"]

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
