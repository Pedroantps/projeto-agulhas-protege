# Database (host local; no Docker, use localhost)
DATABASE_URL=postgresql+psycopg://agulhas:dev_password@localhost:5432/agulhas_protege

# JWT — gere com: openssl rand -hex 32
JWT_SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — lista JSON
CORS_ORIGINS=["http://localhost:5173"]

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Coleta de dados reais (CEMADEN, Open-Meteo, ONS) executada pelo backend
COLETA_HABILITADA=true
COLETA_INTERVALO_MINUTOS=10
# URL pública do painel (aparece na mensagem de alerta do WhatsApp)
PUBLIC_URL=http://localhost:5173
# Produção com HTTPS: COOKIE_SECURE=true (padrão). Em HTTP local: COOKIE_SECURE=false
# Pasta do frontend compilado, servido pela própria API (usado na imagem de produção)
# FRONTEND_DIST_DIR=/app/static
